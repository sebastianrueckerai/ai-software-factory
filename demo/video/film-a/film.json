 "caps": [
  {
   "at": 2.0,
   "text": "<b>Change anything from one chat.</b> The agent proposes, you press Do it."
  },
  {
   "at": 5.2,
   "amber": true,
   "text": "<b>See what is stuck</b> and what waits on you."
  },
  {
   "at": 8.4,
   "text": "<b>Decide what runs next:</b> priorities and a backlog."
  },
  {
   "at": 10.8,
   "amber": true,
   "text": "<b>A card failed twice and used up its budget.</b> One sentence splits it, a click files the parts."
  },
  {
   "at": [
    "drain"
   ],
   "text": "<b>The work resolves</b> and moves to Done."
  },
  {
   "at": [
    "intake",
    27,
    "atMs",
    0.3
   ],
   "text": "<b>New work files itself:</b> a nightly security scan,"
  },
  {
   "at": [
    "intake",
    28,
    "atMs",
    0.3
   ],
   "text": "an alert,"
  },
  {
   "at": [
    "intake",
    29,
    "atMs",
    0.3
   ],
   "text": "a player's issue."
  },
  {
   "at": [
    "ask"
   ],
   "text": "<b>Or you ask for it</b> in one sentence."
  },
  {
   "at": [
    "ask",
    31,
    "act0",
    0.15
   ],
   "text": "<b>Too big for one card:</b> it needs a plan."
  },
  {
   "at": [
    "plan",
    null,
    null,
    1.0
   ],
   "amber": true,
   "text": "<b>The planner writes a plan</b> for your accept."
  },
  {
   "at": [
    "plan",
    34,
    "atMs",
    0.3
   ],
   "text": "<b>You accept, and the four cards land.</b> The agents take it from here."
  },
  {
   "at": [
    "approval"
   ],
   "amber": true,
   "text": "<b>A payments change waits for you.</b>"
  },
  {
   "at": [
    "approval",
    2,
    "act0"
   ],
   "text": "<b>On manual, you read the review and the files,</b>"
  },
  {
   "at": [
    "approval",
    4,
    "act2"
   ],
   "text": "<b>then approve.</b> It merges and goes live."
  },
  {
   "at": [
    "autonomy"
   ],
   "text": "<b>Turn the dial to full auto,</b>"
  },
  {
   "at": [
    "autonomy",
    3,
    "act1"
   ],
   "text": "<b>On full auto, the agent takes the open question,</b>"
  },
  {
   "at": [
    "autonomy",
    4,
    "act0",
    0.3
   ],
   "text": "<b>answers it from the code,</b>"
  },
  {
   "at": [
    "autonomy",
    4,
    "act1",
    1.5
   ],
   "text": "<b>and the card merges</b> once the gates pass."
  },
  {
   "at": [
    "stall"
   ],
   "text": "<b>A session goes in circles.</b>"
  },
  {
   "at": [
    "stall",
    3,
    "act1"
   ],
   "amber": true,
   "text": "<b>A detector trips, and the supervisor steps in.</b>"
  },
  {
   "at": [
    "stall",
    4,
    "act1"
   ],
   "text": "<b>The next session starts from what it learned.</b>"
  },
  {
   "at": [
    "question"
   ],
   "amber": true,
   "text": "<b>What it cannot decide, it asks you,</b> with the choices."
  },
  {
   "at": [
    "question",
    2,
    "act2"
   ],
   "text": "<b>One click answers.</b>"
  },
  {
   "at": [
    "question",
    3,
    "act4"
   ],
   "text": "<b>The card goes on with your pick.</b>"
  },
  {
   "at": [
    "metrics"
   ],
   "text": "<b>The four DevOps delivery metrics,</b> week by week:"
  },
  {
   "at": [
    "metrics",
    5,
    "act1"
   ],
   "text": "<b>what a card costs,</b>"
  },
  {
   "at": [
    "metrics",
    6,
    "act0"
   ],
   "text": "<b>how often it needs you.</b> Tune models and prompts against them."
  },
  {
   "at": [
    "sandbox"
   ],
   "text": ""
  },
  {
   "at": [
    "close"
   ],
