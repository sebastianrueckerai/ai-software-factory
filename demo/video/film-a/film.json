 "caps": [
  {
   "at": [
    "hero",
    null,
    null,
    0.3
   ],
   "text": "<b>A kanban board:</b> where development stands, at a glance."
  },
  {
   "at": [
    "hero",
    null,
    null,
    3.5
   ],
   "text": "<b>Change anything from one chat.</b> The agent proposes, you approve."
  },
  {
   "at": [
    "hero",
    null,
    null,
    6.7
   ],
   "amber": true,
   "text": "<b>See what is stuck</b> and what waits on you."
  },
  {
   "at": [
    "hero",
    null,
    null,
    9.9
   ],
   "text": "<b>Decide what runs next:</b> priorities and a backlog."
  },
  {
   "at": [
    "hero",
    null,
    null,
    12.3
   ],
   "amber": true,
   "parts": [
    {
     "at": [
      "hero",
      null,
      null,
      12.3
     ],
     "text": "<b>A design choice waits for you:</b>"
    },
    {
     "at": [
      "answer",
      4,
      "act2"
     ],
     "text": "one click answers it."
    }
   ]
  },
  {
   "at": [
    "drain"
   ],
   "text": "<b>The work resolves</b> and moves to Done."
  },
  {
   "at": [
    "intake",
    22,
    "atMs",
    0.3
   ],
   "text": "<b>New work files itself:</b> a nightly security scan,"
  },
  {
   "at": [
    "intake",
    23,
    "atMs",
    0.3
   ],
   "text": "an alert,"
  },
  {
   "at": [
    "intake",
    24,
    "atMs",
    0.3
   ],
   "text": "a user's issue."
  },
  {
   "at": [
    "ask"
   ],
   "text": "<b>Or you ask for it</b> in one sentence."
  },
  {
   "at": [
    "ask",
    26,
    "act0",
    0.15
   ],
   "text": "<b>Too big for one card:</b> it needs a plan."
  },
  {
   "at": [
    "plan",
    null,
    null,
    1.0
   ],
   "amber": true,
   "text": "<b>The planner writes a plan</b> for you to accept."
  },
  {
   "at": [
    "plan",
    29,
    "atMs",
    0.3
   ],
   "text": "<b>You accept, and the four cards land.</b> The agents take it from here."
  },
  {
   "at": [
    "autonomy"
   ],
   "text": "<b>Turn the dial to full auto,</b>"
  },
  {
   "at": [
    "auto2",
    5,
    "act0",
    0.3
   ],
   "text": "<b>answers it from the code,</b>"
  },
  {
   "at": [
    "auto2",
    5,
    "act1",
    1.5
   ],
   "text": "<b>and the card merges</b> once the gates pass."
  },
  {
   "at": [
    "stall"
   ],
   "text": "<b>A session goes in circles.</b>"
  },
  {
   "at": [
    "stall",
    3,
    "act1"
   ],
   "amber": true,
   "text": "<b>A detector trips, and the supervisor steps in.</b>"
  },
  {
   "at": [
    "stall",
    4,
    "act1"
   ],
   "text": "<b>The next session starts from what it learned.</b>"
  },
  {
   "at": [
    "close"
   ],
   "cls": "close",
   "shade": true,
   "text": "<b>The worst an agent can do is wreck its own sandbox.</b><small>github.com/sebastianrueckerai/ai-software-factory</small>"
  },
  {
   "at": [
    "approval"
   ],
   "amber": true,
   "text": "<b>A payments change waits for you.</b>"
  },
  {
   "at": [
    "approval",
    2,
    "act0"
   ],
   "text": "<b>On manual, you read the review and the files.</b>"
  },
  {
   "at": [
    "approval",
    4,
    "act2"
   ],
   "text": "<b>One click opens the code</b> in Forgejo."
  },
  {
   "at": [
    "approval",
    5,
    "act1"
   ],
   "text": "<b>Then approve.</b> It merges and goes live."
  },
  {
   "at": [
    "sandbox"
   ],
   "text": ""
  },
  {
   "at": [
    "auto2"
   ],
   "text": "<b>On full auto, the agent takes the open question,</b>"
  },
  {
   "at": [
    "metrics-page"
   ],
   "text": "<b>The DevOps delivery metrics,</b> week by week:"
  },
  {
   "at": [
    "metrics",
    5,
    "act1"
   ],
   "text": "<b>what a card costs,</b>"
  },
  {
   "at": [
    "metrics",
    6,
    "act0"
   ],
   "text": "<b>how often it needs you.</b>"
  },
  {
   "at": [
    "metrics-end"
   ],
   "text": "<b>Tune your process, harness and prompts</b> on data, not hunches.",
