+.once-k { margin: 8px 0 3px; color: var(--text-faint); font: 11.5px var(--font-mono); font-variant-caps: all-small-caps; letter-spacing: .06em; }
+code.sel { display: block; padding: 5px 8px; border: 1px solid var(--line); border-radius: 2px; background: var(--bg); color: var(--text); font-size: 12px; line-height: 1.5; overflow-wrap: anywhere; user-select: all; cursor: text; }
+.mint { display: grid; grid-template-columns: max-content minmax(0, 24rem); gap: 8px 14px; align-items: center; margin: 18px 0 0; }
+.mint h4 { grid-column: 1 / -1; margin: 0 0 2px; color: var(--text-muted); font: 600 12.5px var(--font-ui); font-variant-caps: all-small-caps; letter-spacing: .07em; }
+.mint label { margin: 0; text-align: right; }
+.mint input { height: 28px; }
+@media (max-width: 899px) {
+  .notify tr.once-row > td { padding: 0 8px 12px; }
+  .mint { grid-template-columns: minmax(0, 1fr); gap: 4px; }
+  .mint label { margin-top: 6px; text-align: left; }
+  .mint input, .mint select, .mint button { width: 100%; max-width: none; height: 44px; }
+}
